# TECNATO ADMIN — copia para .env e preenche (NUNCA commitar)

# Supabase (mesmo projecto do site)
SUPABASE_URL=https://SEU-PROJECTO.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=candidaturas
SUPABASE_BUCKET_PERFIS=perfis

# Sessão admin (64 hex, gerar localmente)
ADMIN_SECRET=

# Contas admin — senhas em hash scrypt (nunca texto plano)
# Exemplo: [{"name":"Nome","email":"email@dominio.com","passwordHash":"scrypt$salt$hash"}]
ADMIN_USERS='[]'

# Origem permitida (em produção: https://admin.seudominio.com)
ADMIN_ORIGIN=http://localhost:5175

# Porta da API (Netlify Functions ignora, mas mantém para dev local)
PORT=5200

# AI para relatórios (chave NVIDIA só no servidor/Netlify Functions)
ADMIN_AI_API_KEY=
ADMIN_AI_MODEL=nvidia/nemotron-3-ultra-550b-a55b
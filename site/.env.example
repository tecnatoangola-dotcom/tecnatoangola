# TECNATO — copia este ficheiro para .env e preenche os teus valores

# Supabase (mesmo projecto do admin) — usados pela function Netlify /api/conteudo
# A service key fica SÓ no servidor (Netlify Environment Variables), nunca no browser
SUPABASE_URL=https://SEU-PROJECTO.supabase.co
SUPABASE_SERVICE_KEY=

# Supabase público (browser) — para upload de candidaturas, auth, etc.
VITE_SUPABASE_URL=https://SEU-PROJECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=candidaturas
VITE_MAX_VIDEO_MB=30

# AI Chat (Tecnocrata) — function Netlify /api/ai-chat
# A chave NVIDIA fica SÓ no servidor (Netlify Environment Variables)
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b

# Google Search Console / Bing Webmaster Tools (opcional)
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
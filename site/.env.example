# TECNATO — copia este ficheiro para .env e preenche os teus valores

# Contenido do site (aba «Site» do CRM) — usados pelo middleware dev e pela
# function Netlify /api/conteudo (a chave fica só no servidor, nunca no browser)
SUPABASE_URL=https://SEU-PROJECTO.supabase.co
SUPABASE_SERVICE_KEY=

# Candidaturas (fluxo de envio no browser — anon key pública)
VITE_SUPABASE_URL=https://SEU-PROJECTO.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_SUPABASE_BUCKET=candidaturas
VITE_MAX_VIDEO_MB=30
